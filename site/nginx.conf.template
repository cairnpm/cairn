server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_min_length 1024;
  gzip_types text/css text/plain application/javascript application/json application/xml image/svg+xml;

  # Nuxt fingerprints everything under /_nuxt, so it can be cached forever. The HTML must NOT be, or a
  # redeploy would keep serving the previous page from browser caches.
  location /_nuxt/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # PostHog, same-origin. Cairn's audience is developers — the most ad-blocked audience there is — and
  # a direct posthog.com request is simply dropped for a large slice of them. Proxying it under our own
  # domain is what makes the numbers mean anything. Matches `posthogHost` in site/nuxt.config.ts.
  #
  # The regex captures the tail so the upstream URI is written out in full: a proxy_pass carrying a
  # variable skips nginx's usual "swap the location prefix" rewrite.
  # The platform's own DNS, not a hardcoded public one: Fly (and Docker) resolve through the resolver in
  # /etc/resolv.conf, and outbound port 53 to 1.1.1.1 is not guaranteed to be open. The nginx image's
  # entrypoint exports NGINX_LOCAL_RESOLVERS from resolv.conf and envsubst fills it in here — which is
  # why this file is a .template mounted into /etc/nginx/templates/.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=300s ipv6=off;

  # The SDK bundle and its lazily-loaded chunks live on the assets host, not the ingest host.
  location ~ ^/ingest/static/(.*)$ {
    proxy_pass https://eu-assets.i.posthog.com/static/$1$is_args$args;
    proxy_set_header Host eu-assets.i.posthog.com;
    proxy_ssl_server_name on;
    # No proxy_cache zone here on purpose: PostHog already sends its own Cache-Control on these bundles
    # and nginx passes it straight through to the browser, which is the cache that matters.
  }

  location ~ ^/ingest/(.*)$ {
    proxy_pass https://eu.i.posthog.com/$1$is_args$args;
    proxy_set_header Host eu.i.posthog.com;
    proxy_ssl_server_name on;
    # Without this every event is attributed to the Fly machine's IP, killing geo breakdowns.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # Prerendered routes are files: /foo → /foo.html.
  location / {
    try_files $uri $uri.html $uri/ =404;
  }

  error_page 404 /404.html;
}
